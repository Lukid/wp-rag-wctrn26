                "parameters": {
                    "jsCode": "// Costruisce il prompt con contesto dai risultati reranked\nconst reranked = $json.results;\nconst metadata = $('Prepara Rerank').first().json.metadata;\nconst userQuery = $('Normalizza Input').first().json.message;\n\n// Contesto dai risultati migliori dopo reranking\nconst contextParts = reranked.map(r => {\n  const meta = metadata[r.index];\n  return `### ${meta.title}\\n${meta.text}\\n(Fonte: ${meta.url})`;\n});\nconst context = contextParts.join('\\n\\n---\\n\\n');\n\n// Fonti per la risposta\nconst sources = reranked.map(r => ({\n  title: metadata[r.index].title,\n  url: metadata[r.index].url\n}));\n\nconst systemMessage = `Sei l'assistente virtuale del sito \"Le Meraviglie Segrete di Pisa\", un sito turistico dedicato alle curiosit\\u00e0 e ai segreti di Pisa.\\n\\nRispondi in italiano, con tono amichevole e un pizzico di umorismo toscano.\\n\\nREGOLE:\\n- Rispondi SOLO basandoti sul contesto fornito qui sotto\\n- Se la risposta non \\u00e8 nel contesto, d\\u00ec chiaramente che non hai informazioni su questo argomento\\n- Cita le fonti quando possibile\\n- Sii conciso ma completo\\n\\nCONTESTO:\\n${context}`;\n\nconst requestBody = {\n  model: \"gpt-5.4-mini\",\n  messages: [\n    { role: \"system\", content: systemMessage },\n    { role: \"user\", content: userQuery }\n  ],\n  temperature: 0.3\n};\n\nreturn [{ json: { requestBody, sources } }];"
