        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/embeddings",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "input",
                            "value": "={{ $json.batch.map(item => item.text) }}"
                        },
                        {
                            "name": "model",
                            "value": "text-embedding-3-large"
                        }
                    ]
                },
                "options": {}
            },
            "id": "d0a00001-0001-0001-0001-000000000009",
            "name": "Embedding OpenAI",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1792,
                432
            ],
            "credentials": {
                "openAiApi": {
                    "id": "FNKVVjlaCXAocWHU",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Combina embedding densi + BM25 sparsi e formatta per Qdrant\nconst batch = $('Aggrega Batch').first().json.batch;\nconst embeddings = $input.first().json.data;\n\nconst points = batch.map((item, i) => ({\n  id: item.chunk_id,\n  payload: {\n    text: item.text,\n    title: item.title,\n    url: item.url,\n    post_type: item.post_type,\n    categories: item.categories\n  },\n  vector: {\n    dense: embeddings[i].embedding,\n    bm25: {\n      text: item.text,\n      model: \"qdrant/bm25\",\n      options: { avg_len: item.avg_len }\n    }\n  }\n}));\n\nreturn [{ json: { points } }];"
            },
