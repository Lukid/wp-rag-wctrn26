            "id": "d0a00001-0001-0001-0001-000000000005",
            "name": "Scarica Contenuto",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                912,
                304
            ],
            "onError": "continueRegularOutput"
        },
        {
            "parameters": {
                "jsCode": "// Parsing dei contenuti WordPress e preparazione chunks\nconst chunks = [];\nlet totalWords = 0;\n\nfor (const item of $input.all()) {\n  const md = item.json.data;\n  const match = md.match(/^---\\n([\\s\\S]*?)\\n---\\n([\\s\\S]*)$/);\n  if (!match) continue;\n\n  const fm = match[1];\n  const content = match[2].trim();\n\n  // Estrai metadati dal frontmatter\n  const title = (fm.match(/title:\\s*(.+)/)?.[1] || '')\n    .replace(/^[\"']|[\"']$/g, '').trim();\n  const url = (fm.match(/url:\\s*\"([^\"]+)\"/)?.[1] || '').trim();\n  const postType = (fm.match(/post_type:\\s*(\\w+)/)?.[1] || '').trim();\n\n  const catBlock = fm.match(/categories:\\n((?:\\s+-\\s+.+\\n?)*)/);\n  const categories = catBlock\n    ? (catBlock[1].match(/-\\s+(.+)/g) || []).map(c => c.replace(/^-\\s+/, '').trim())\n    : [];\n\n  // Un chunk per post (contenuti brevi, ideali per la demo)\n  const text = title + '\\n\\n' + content;\n  totalWords += text.split(/\\s+/).length;\n  chunks.push({ text, title, url, post_type: postType, categories });\n}\n\n// Lunghezza media testi per BM25\nconst avgLen = Math.round(totalWords / chunks.length);\n\nreturn chunks.map((c, i) => ({\n  json: { ...c, chunk_id: i, avg_len: avgLen }\n}));"
            },
            "id": "d0a00001-0001-0001-0001-000000000006",
            "name": "Parsing e Chunks",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1120,
                304
            ]
        },
        {
            "parameters": {
                "batchSize": 10,
                "options": {
                    "reset": false
                }
            },
            "id": "d0a00001-0001-0001-0001-000000000007",
            "name": "Loop per Batch",
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                1344,
                304
            ]
        },
        {
